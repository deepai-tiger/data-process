      "system_prompt": "당신은 한국어 문서를 정확하게 이해하고 답변하는 유용한 AI 어시스턴트입니다.",
      "max_samples_per_doc": 200,
      "seed": 20240501
    },
    "dataset": {
      "name": "korean-doc-corpus",
      "render_templates": [
        "qwen",
        "llama3",
        "deepseek"
