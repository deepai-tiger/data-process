{
  "config": {
    "paths": {
      "raw_dir": "raw",
      "out_dir": "out"
    },
    "ocr": {
      "engine": "tesseract_cli",
      "languages": [
        "kor",
        "eng"
      ],
      "force_full_page": true,
      "min_confidence": 0.0,
      "psm": 6
    },
    "pdf": {
      "mode": "page_images",
      "dpi": 200,
      "pages": "",
      "max_pages": null,
      "table_mode": "accurate",
      "do_tables": true,
      "do_formulas": true,
      "formula_engine": "pix2tex",
      "formula_split_stacked": true,
      "formula_strip_equation_number": true,
      "keep_page_images": true,
      "cache": true
    },
    "word": {
      "soffice_bin": "soffice",
      "convert_timeout_s": 240,
      "keep_converted": true,
      "include_footnotes": true,
      "include_headers_footers": false
    },
    "normalize": {
      "spacing_engine": "kiwi",
      "spacing_ocr_only": true,
      "unicode_form": "NFC",
      "strip_control_chars": true,
      "join_wrapped_lines": true,
      "dehyphenate": true,
      "normalize_punctuation": true,
      "merge_page_continuations": true,
      "infer_headings": true,
      "header_footer_page_ratio": 0.5,
      "drop_page_numbers": true
    },
    "quality": {
      "min_doc_chars": 200,
      "min_block_chars": 10,
      "min_hangul_ratio": 0.25,
      "max_symbol_ratio": 0.3,
      "max_digit_ratio": 0.5,
      "max_dup_line_ratio": 0.3,
      "max_top_ngram_ratio": 0.2,
      "keep_latin_only_blocks": true
    },
    "dedup": {
      "exact": true,
      "near": true,
      "threshold": 0.85,
      "num_perm": 128,
      "shingle_size": 5,
      "paragraph_level": true,
      "min_paragraph_chars_for_dedup": 80
    },
    "pii": {
      "enabled": true,
      "mask_email": true,
      "mask_phone": true,
      "mask_rrn": true,
      "mask_card": true,
      "mask_url": false,
      "placeholder_prefix": "[MASKED_"
    },
    "chunk": {
      "tokenizer": "Qwen/Qwen2.5-7B",
      "max_tokens": 2048,
      "min_tokens": 64,
      "overlap_tokens": 0,
      "keep_latex_atomic": true,
      "prepend_heading_path": true
    },
    "sft": {
      "enabled": true,
      "tasks": [
        "summarize_title",
        "continuation",
        "table_to_latex",
        "equation_to_latex",
        "qa_definition"
